.card.shadow-sm
  .card-body
    = link_to t(".back"),
              repository_path(@repository),
              class: "btn btn-primary mb-4"

    h1 = t(".title", id: @check.id)

    table.table
      tbody
        tr
          th = t(".created_at")
          td = l(@check.created_at, format: :check)

        tr
          th = t(".status")
          td = t("web.repositories.checks.states.#{@check.aasm_state}")

        tr
          th = t(".passed")
          td
            - if @check.passed.nil?
              | —
            - else
              = @check.passed

        tr
          th = t(".commit_id")
          td = @check.commit_id.presence || "—"